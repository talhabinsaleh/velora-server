# MongoDB (the same database the client uses for Better Auth)
MONGODB_URI=
DB_NAME=salonbook

# Must match JWT_SECRET in the client. The client signs the token, this server verifies it.
JWT_SECRET=

# Website address(es), comma separated. Used for CORS and Stripe redirect URLs.
CLIENT_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ImgBB image hosting
IMGBB_API_KEY=

PORT=5000
